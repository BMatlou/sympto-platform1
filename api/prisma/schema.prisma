model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  description String
  quantity    Decimal @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(12, 2)
  discount    Decimal @default(0) @db.Decimal(12, 2)
  tax         Decimal @default(0) @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Receipt {
  id            String    @id @default(uuid())
  receiptNumber String    @unique
  patientId     String
  issuedAt      DateTime  @default(now())
  total         Decimal   @db.Decimal(12, 2)
  payments      Payment[]
  patient       Patient   @relation(fields: [patientId], references: [id])
}

model PaymentAllocation {
  id        String  @id @default(uuid())
  paymentId String
  invoiceId String
  amount    Decimal @db.Decimal(12, 2)
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([paymentId, invoiceId])
}

model Claim {
  id                 String               @id @default(uuid())
  patientId          String
  invoiceId          String               @unique
  patientInsuranceId String?
  claimNumber        String               @unique
  status             ClaimStatus          @default(DRAFT)
  submittedAt        DateTime?
  processedAt        DateTime?
  approvedAmount     Decimal?             @db.Decimal(12, 2)
  rejectedReason     String?
  insurancePolicyId  String?
  insurancePolicy    InsurancePolicy?     @relation(fields: [insurancePolicyId], references: [id])
  invoice            Invoice              @relation(fields: [invoiceId], references: [id])
  patient            Patient              @relation(fields: [patientId], references: [id])
  patientInsurance   PatientInsurance?    @relation(fields: [patientInsuranceId], references: [id])
  claimDocuments     ClaimDocument[]
  payments           ClaimPayment[]
  statusHistory      ClaimStatusHistory[]
}

model ClaimPayment {
  id        String   @id @default(uuid())
  claimId   String
  amount    Decimal  @db.Decimal(12, 2)
  paidAt    DateTime
  reference String?
  claim     Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
}

model Refund {
  id         String       @id @default(uuid())
  paymentId  String
  amount     Decimal      @db.Decimal(12, 2)
  reason     String
  status     RefundStatus @default(PENDING)
  reference  String?
  notes      String?
  refundedAt DateTime     @default(now())
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([status])
}

model FinancialAdjustment {
  id        String         @id @default(uuid())
  invoiceId String
  type      AdjustmentType
  amount    Decimal        @db.Decimal(12, 2)
  reason    String?
  createdAt DateTime       @default(now())
  invoice   Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model PriceList {
  id          String          @id @default(uuid())
  name        String
  description String?
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  items       PriceListItem[]
}

model PriceListItem {
  id          String    @id @default(uuid())
  priceListId String
  serviceCode String
  serviceName String
  price       Decimal   @db.Decimal(12, 2)
  priceList   PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)

  @@unique([priceListId, serviceCode])
}

model CarePlan {
  id                String           @id @default(uuid())
  patientId         String
  practitionerId    String
  encounterId       String?
  title             String
  description       String?
  clinicalEpisodeId String?
  status            CarePlanStatus   @default(DRAFT)
  startDate         DateTime
  endDate           DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  encounter         Encounter?       @relation(fields: [encounterId], references: [id])
  patient           Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  practitioner      Practitioner     @relation(fields: [practitionerId], references: [id])
  clinicalEpisode   ClinicalEpisode? @relation(fields: [clinicalEpisodeId], references: [id], onDelete: SetNull)
  goals             CarePlanGoal[]
  notes             CarePlanNote[]
  tasks             CarePlanTask[]
  healthGoals       HealthGoal[]
}

model CarePlanGoal {
  id           String             @id @default(uuid())
  carePlanId   String
  title        String
  description  String?
  targetValue  String?
  currentValue String?
  dueDate      DateTime?
  status       CarePlanGoalStatus @default(NOT_STARTED)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  carePlan     CarePlan           @relation(fields: [carePlanId], references: [id], onDelete: Cascade)
}

model CarePlanTask {
  id           String             @id @default(uuid())
  carePlanId   String
  assignedToId String?
  type         CarePlanTaskType
  title        String
  description  String?
  dueDate      DateTime?
  completedAt  DateTime?
  status       CarePlanTaskStatus @default(PENDING)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  assignedTo   User?              @relation(fields: [assignedToId], references: [id])
  carePlan     CarePlan           @relation(fields: [carePlanId], references: [id], onDelete: Cascade)
}

model CarePlanNote {
  id         String   @id @default(uuid())
  carePlanId String
  authorId   String
  note       String
  createdAt  DateTime @default(now())
  author     User     @relation(fields: [authorId], references: [id])
  carePlan   CarePlan @relation(fields: [carePlanId], references: [id], onDelete: Cascade)
}

model Referral {
  id                      String                  @id @default(uuid())
  patientId               String
  referringPractitionerId String
  receivingPractitionerId String?
  referringPracticeId     String?
  receivingPracticeId     String?
  encounterId             String?
  appointmentId           String?
  referralNumber          String                  @unique
  type                    ReferralType
  priority                ReferralPriority        @default(ROUTINE)
  status                  ReferralStatus          @default(PENDING)
  specialty               String?
  reason                  String
  clinicalSummary         String?
  clinicalEpisodeId       String?
  requestedDate           DateTime                @default(now())
  acceptedDate            DateTime?
  completedDate           DateTime?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  aisymptomAssessments    AISymptomAssessment[]
  appointment             Appointment?            @relation(fields: [appointmentId], references: [id])
  encounter               Encounter?              @relation(fields: [encounterId], references: [id])
  patient                 Patient                 @relation(fields: [patientId], references: [id], onDelete: Cascade)
  receivingPractice       Practice?               @relation("ReceivingPractice", fields: [receivingPracticeId], references: [id])
  receivingPractitioner   Practitioner?           @relation("ReceivingPractitioner", fields: [receivingPractitionerId], references: [id])
  referringPractice       Practice?               @relation("ReferringPractice", fields: [referringPracticeId], references: [id])
  referringPractitioner   Practitioner            @relation("ReferringPractitioner", fields: [referringPractitionerId], references: [id])
  clinicalEpisode         ClinicalEpisode?        @relation(fields: [clinicalEpisodeId], references: [id], onDelete: SetNull)
  documents               ReferralDocument[]
  feedback                ReferralFeedback?
  notes                   ReferralNote[]
  statusHistory           ReferralStatusHistory[]
}

model ReferralDocument {
  id         String   @id @default(uuid())
  referralId String
  fileName   String
  fileUrl    String
  mimeType   String?
  uploadedAt DateTime @default(now())
  referral   Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)
}

model ReferralNote {
  id         String   @id @default(uuid())
  referralId String
  authorId   String
  note       String
  createdAt  DateTime @default(now())
  author     User     @relation(fields: [authorId], references: [id])
  referral   Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)
}

model ReferralStatusHistory {
  id         String         @id @default(uuid())
  referralId String
  status     ReferralStatus
  changedAt  DateTime       @default(now())
  notes      String?
  referral   Referral       @relation(fields: [referralId], references: [id], onDelete: Cascade)
}

model ReferralFeedback {
  id               String   @id @default(uuid())
  referralId       String   @unique
  diagnosis        String?
  recommendations  String?
  followUpRequired Boolean  @default(false)
  followUpNotes    String?
  createdAt        DateTime @default(now())
  referral         Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)
}

model ClinicalDecisionSupport {
  id                 String                @id @default(uuid())
  patientId          String
  encounterId        String?
  practitionerId     String
  recommendationType CDSRecommendationType
  title              String
  description        String
  evidence           String?
  guidelineSource    String?
  aiModel            String?
  confidence         Decimal?              @db.Decimal(5, 2)
  severity           CDSSeverity
  status             CDSStatus             @default(GENERATED)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  actions            CDSAction[]
  alerts             CDSAlert[]
  cdsoverrides       CDSOverride[]
  encounter          Encounter?            @relation(fields: [encounterId], references: [id])
  patient            Patient               @relation(fields: [patientId], references: [id], onDelete: Cascade)
  practitioner       Practitioner          @relation(fields: [practitionerId], references: [id])
}

model CDSAction {
  id                        String                  @id @default(uuid())
  clinicalDecisionSupportId String
  userId                    String
  action                    String
  notes                     String?
  createdAt                 DateTime                @default(now())
  clinicalDecisionSupport   ClinicalDecisionSupport @relation(fields: [clinicalDecisionSupportId], references: [id], onDelete: Cascade)
  user                      User                    @relation(fields: [userId], references: [id])
}

model CDSAlert {
  id                        String                  @id @default(uuid())
  clinicalDecisionSupportId String
  title                     String
  message                   String
  severity                  CDSSeverity
  acknowledged              Boolean                 @default(false)
  acknowledgedAt            DateTime?
  createdAt                 DateTime                @default(now())
  clinicalDecisionSupport   ClinicalDecisionSupport @relation(fields: [clinicalDecisionSupportId], references: [id], onDelete: Cascade)
}

model CDSRule {
  id                String             @id @default(uuid())
  code              String             @unique
  name              String
  description       String?
  version           String?
  active            Boolean            @default(true)
  ruleDefinition    Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  cdsruleExecutions CDSRuleExecution[]
}

model CDSRuleExecution {
  id          String     @id @default(uuid())
  ruleId      String
  patientId   String
  encounterId String?
  triggered   Boolean
  score       Decimal?   @db.Decimal(8, 2)
  executedAt  DateTime   @default(now())
  encounter   Encounter? @relation(fields: [encounterId], references: [id])
  patient     Patient    @relation(fields: [patientId], references: [id])
  rule        CDSRule    @relation(fields: [ruleId], references: [id])
}

model CDSOverride {
  id                        String                  @id @default(uuid())
  clinicalDecisionSupportId String
  practitionerId            String
  reason                    String
  comments                  String?
  overriddenAt              DateTime                @default(now())
  clinicalDecisionSupport   ClinicalDecisionSupport @relation(fields: [clinicalDecisionSupportId], references: [id], onDelete: Cascade)
  practitioner              Practitioner            @relation(fields: [practitionerId], references: [id])
}

model PublicHealthReport {
  id             String                   @id @default(uuid())
  reportNumber   String                   @unique
  reportType     PublicHealthReportType
  status         PublicHealthReportStatus @default(DRAFT)
  priority       PublicHealthPriority     @default(NORMAL)
  patientId      String?
  encounterId    String?
  practitionerId String?
  organizationId String?
  title          String
  description    String?
  diseaseCode    String?
  diseaseName    String?
  reportData     Json
  submittedAt    DateTime?
  acknowledgedAt DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  departmentId   String?
  attachments    PublicHealthAttachment[]
  department     Department?              @relation(fields: [departmentId], references: [id])
  encounter      Encounter?               @relation(fields: [encounterId], references: [id])
  organization   Organization?            @relation(fields: [organizationId], references: [id])
  patient        Patient?                 @relation(fields: [patientId], references: [id])
  practitioner   Practitioner?            @relation(fields: [practitionerId], references: [id])
  submissions    PublicHealthSubmission[]
}

model PublicHealthSubmission {
  id              String             @id @default(uuid())
  reportId        String
  destination     String
  responseCode    String?
  responseMessage String?
  submittedAt     DateTime           @default(now())
  report          PublicHealthReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

model PublicHealthAttachment {
  id         String             @id @default(uuid())
  reportId   String
  fileName   String
  fileUrl    String
  mimeType   String?
  uploadedAt DateTime           @default(now())
  report     PublicHealthReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

model DiseaseRegistry {
  id                   String   @id @default(uuid())
  code                 String   @unique
  name                 String
  category             String?
  notifiable           Boolean  @default(false)
  reportingWindowHours Int?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Consent {
  id              String    @id @default(uuid())
  patientId       String
  grantedToUserId String?
  type            String
  purpose         String?
  granted         Boolean   @default(true)
  grantedAt       DateTime  @default(now())
  expiresAt       DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  grantedToUser   User?     @relation(fields: [grantedToUserId], references: [id])
  patient         Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model PractitionerOrganization {
  id                  String       @id @default(uuid())
  practitionerId      String
  organizationId      String
  departmentId        String?
  licenseNumber       String?
  primaryOrganization Boolean      @default(false)
  startDate           DateTime?
  endDate             DateTime?
  active              Boolean      @default(true)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  department          Department?  @relation(fields: [departmentId], references: [id])
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  practitioner        Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)

  @@unique([practitionerId, organizationId])
}

model SymptomLog {
  id                String                 @id @default(uuid())
  clinicalEpisodeId String
  title             String?
  notes             String?                @db.Text
  status            SymptomLogStatus       @default(ACTIVE)
  overallSeverity   SymptomSeverity?
  progression       SymptomProgression?
  startedAt         DateTime
  resolvedAt        DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  clinicalEpisode   ClinicalEpisode        @relation(fields: [clinicalEpisodeId], references: [id], onDelete: Cascade)
  symptoms          SymptomLogItem[]
  triggers          SymptomTrigger[]
  medicationEffects MedicationEffect[]
  observations      AIObservation[]
  attachments       SymptomLogAttachment[]

  @@index([clinicalEpisodeId])
  @@index([status])
  @@index([overallSeverity])
  @@index([startedAt])
}

model SymptomLogItem {
  id                 String              @id @default(uuid())
  symptomLogId       String
  symptomId          String
  severity           SymptomSeverity     @default(MILD)
  progression        SymptomProgression?
  frequency          SymptomFrequency?
  painCharacter      PainCharacter?
  painScore          Int?
  durationMinutes    Int?
  onsetAt            DateTime?
  resolvedAt         DateTime?
  intermittent       Boolean             @default(false)
  recurring          Boolean             @default(false)
  suspectedTrigger   String?
  aggravatingFactors String?
  relievingFactors   String?
  notes              String?             @db.Text
  createdAt          DateTime            @default(now())
  symptomLog         SymptomLog          @relation(fields: [symptomLogId], references: [id], onDelete: Cascade)
  symptom            Symptom             @relation(fields: [symptomId], references: [id])
  aisymptom          AISymptom?          @relation(fields: [aISymptomId], references: [id])
  aISymptomId        String?

  @@index([symptomLogId])
  @@index([symptomId])
  @@index([severity])
  @@index([progression])
  @@index([onsetAt])
}

model HealthJournal {
  id                     String             @id @default(uuid())
  patientId              String
  encounterId            String?
  practitionerId         String?
  title                  String?
  journal                String             @db.Text
  mood                   HealthJournalMood?
  sleepQuality           SleepQuality?
  sleepHours             Decimal?           @db.Decimal(4, 2)
  energyLevel            EnergyLevel?
  stressLevel            Int?
  exerciseMinutes        Int?
  waterIntakeMl          Int?
  weightKg               Decimal?           @db.Decimal(6, 2)
  temperature            Decimal?           @db.Decimal(4, 1)
  bloodPressureSystolic  Int?
  bloodPressureDiastolic Int?
  heartRate              Int?
  oxygenSaturation       Decimal?           @db.Decimal(5, 2)
  respiratoryRate        Int?
  notes                  String?            @db.Text
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  patient                Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  encounter              Encounter?         @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  practitioner           Practitioner?      @relation(fields: [practitionerId], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@index([encounterId])
  @@index([practitionerId])
  @@index([createdAt])
  @@index([mood])
  @@index([energyLevel])
}

model SymptomTrigger {
  id                  String     @id @default(uuid())
  symptomLogId        String
  trigger             String
  description         String?    @db.Text
  suspected           Boolean    @default(true)
  confirmed           Boolean    @default(false)
  exposureAt          DateTime?
  occurredBeforeHours Int?
  notes               String?    @db.Text
  createdAt           DateTime   @default(now())
  symptomLog          SymptomLog @relation(fields: [symptomLogId], references: [id], onDelete: Cascade)

  @@index([symptomLogId])
  @@index([trigger])
  @@index([suspected])
  @@index([confirmed])
  @@index([exposureAt])
}

model MedicationEffect {
  id                    String        @id @default(uuid())
  symptomLogId          String
  medicationId          String
  prescriptionId        String? // <-- ADD HERE
  effectiveness         Int?
  improved              Boolean?
  improvementPercentage Int?
  startedMedicationAt   DateTime?
  improvementObservedAt DateTime?
  stoppedMedicationAt   DateTime?
  sideEffects           String?       @db.Text
  notes                 String?       @db.Text
  createdAt             DateTime      @default(now())
  symptomLog            SymptomLog    @relation(fields: [symptomLogId], references: [id], onDelete: Cascade)
  medication            Medication    @relation(fields: [medicationId], references: [id], onDelete: Restrict)
  prescription          Prescription? @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)

  @@index([symptomLogId])
  @@index([medicationId])
  @@index([prescriptionId])
  @@index([improved])
  @@index([startedMedicationAt])
}

model AIObservation {
  id                String      @id @default(uuid())
  symptomLogId      String
  aiAnalysisId      String?
  observation       String      @db.Text
  confidenceScore   Decimal?    @db.Decimal(5, 2)
  recommendation    String?     @db.Text
  requiresAttention Boolean     @default(false)
  reviewed          Boolean     @default(false)
  reviewedAt        DateTime?
  createdAt         DateTime    @default(now())
  symptomLog        SymptomLog  @relation(fields: [symptomLogId], references: [id], onDelete: Cascade)
  aiAnalysis        AIAnalysis? @relation(fields: [aiAnalysisId], references: [id], onDelete: SetNull)

  @@index([symptomLogId])
  @@index([aiAnalysisId])
  @@index([requiresAttention])
  @@index([reviewed])
}

model ClinicalEpisode {
  id              String                      @id @default(uuid())
  patientId       String
  encounterId     String?
  appointmentId   String?
  practitionerId  String?
  title           String
  description     String?                     @db.Text
  type            ClinicalEpisodeType
  status          ClinicalEpisodeStatus       @default(ACTIVE)
  priority        EpisodePriority             @default(ROUTINE)
  startedAt       DateTime
  endedAt         DateTime?
  resolvedAt      DateTime?
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  patient         Patient                     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  encounter       Encounter?                  @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  appointment     Appointment?                @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  practitioner    Practitioner?               @relation(fields: [practitionerId], references: [id], onDelete: SetNull)
  symptomLogs     SymptomLog[]
  diagnoses       Diagnosis[]
  clinicalNotes   ClinicalNote[]
  clinicalVitals  ClinicalVital[]
  prescriptions   Prescription[]
  labOrders       LabOrder[]
  labResults      LabResult[]
  imagingOrders   ImagingOrder[]
  imagingStudies  ImagingStudy[]
  aiAnalyses      AIAnalysis[]
  carePlans       CarePlan[]
  referrals       Referral[]
  attachments     ClinicalEpisodeAttachment[]
  riskAssessments RiskAssessment[]

  @@index([patientId])
  @@index([encounterId])
  @@index([appointmentId])
  @@index([practitionerId])
  @@index([type])
  @@index([status])
  @@index([priority])
  @@index([startedAt])
}

model ClinicalEpisodeAttachment {
  id                String                        @id @default(uuid())
  clinicalEpisodeId String
  attachmentId      String
  type              ClinicalEpisodeAttachmentType
  description       String?
  isPrimary         Boolean                       @default(false)
  createdAt         DateTime                      @default(now())
  clinicalEpisode   ClinicalEpisode               @relation(fields: [clinicalEpisodeId], references: [id], onDelete: Cascade)

  attachment Attachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)

  @@unique([clinicalEpisodeId, attachmentId])
  @@index([attachmentId])
  @@index([type])
}

model SymptomLogAttachment {
  id           String                     @id @default(uuid())
  symptomLogId String
  attachmentId String
  type         SymptomAttachmentType
  category     SymptomAttachmentCategory?
  isPrimary    Boolean                    @default(false)
  description  String?
  createdAt    DateTime                   @default(now())
  symptomLog   SymptomLog                 @relation(fields: [symptomLogId], references: [id], onDelete: Cascade)

  attachment Attachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)

  @@unique([symptomLogId, attachmentId])
  @@index([attachmentId])
  @@index([type])
  @@index([category])
}

model HealthGoal {
  id             String             @id @default(uuid())
  patientId      String
  practitionerId String?
  carePlanId     String?
  title          String
  description    String?            @db.Text
  category       HealthGoalCategory

  priority HealthGoalPriority @default(MEDIUM)
  status   HealthGoalStatus   @default(ACTIVE)

  targetValue  Decimal?  @db.Decimal(12, 2)
  currentValue Decimal?  @db.Decimal(12, 2)
  unit         String?
  targetDate   DateTime?
  achievedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  practitioner Practitioner? @relation(fields: [practitionerId], references: [id], onDelete: SetNull)
  carePlan     CarePlan?     @relation(fields: [carePlanId], references: [id], onDelete: SetNull)

  progress HealthGoalProgress[]

  @@index([patientId])
  @@index([carePlanId])
  @@index([status])
  @@index([category])
  @@index([targetDate])
}

model HealthGoalProgress {
  id              String                   @id @default(uuid())
  healthGoalId    String
  currentValue    Decimal?                 @db.Decimal(12, 2)
  progressPercent Decimal?                 @db.Decimal(5, 2)
  status          HealthGoalProgressStatus
  notes           String?                  @db.Text
  measuredAt      DateTime
  createdAt       DateTime                 @default(now())
  healthGoal      HealthGoal               @relation(fields: [healthGoalId], references: [id], onDelete: Cascade)

  @@index([healthGoalId])
  @@index([status])
  @@index([measuredAt])
}

model RiskAssessment {
  id                String             @id @default(uuid())
  patientId         String
  practitionerId    String?
  clinicalEpisodeId String?
  assessmentType    RiskAssessmentType
  overallRisk       RiskLevel
  score             Decimal?           @db.Decimal(6, 2)
  notes             String?            @db.Text
  assessedAt        DateTime
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  patient         Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  practitioner    Practitioner?    @relation(fields: [practitionerId], references: [id], onDelete: SetNull)
  clinicalEpisode ClinicalEpisode? @relation(fields: [clinicalEpisodeId], references: [id], onDelete: SetNull)

  results RiskAssessmentResult[]

  @@index([patientId])
  @@index([assessmentType])
  @@index([overallRisk])
  @@index([assessedAt])
}

model RiskAssessmentResult {
  id               String         @id @default(uuid())
  riskAssessmentId String
  factor           String
  value            String?
  score            Decimal?       @db.Decimal(6, 2)
  recommendation   String?        @db.Text
  createdAt        DateTime       @default(now())
  riskAssessment   RiskAssessment @relation(fields: [riskAssessmentId], references: [id], onDelete: Cascade)

  @@index([riskAssessmentId])
  @@index([factor])
}

model PatientBaseline {
  id                String    @id @default(uuid())
  patientId         String    @unique
  weightKg          Decimal?  @db.Decimal(6, 2)
  heightCm          Decimal?  @db.Decimal(6, 2)
  bmi               Decimal?  @db.Decimal(5, 2)
  systolicPressure  Int?
  diastolicPressure Int?
  restingHeartRate  Int?
  respiratoryRate   Int?
  oxygenSaturation  Decimal?  @db.Decimal(5, 2)
  bodyTemperature   Decimal?  @db.Decimal(4, 1)
  bloodGlucose      Decimal?  @db.Decimal(6, 2)
  cholesterol       Decimal?  @db.Decimal(6, 2)
  notes             String?   @db.Text
  establishedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

