generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model OnboardingProgress {
  id String @id @default(uuid())

  userId String @unique

  currentStep Int @default(1)

  completionPercentage Int @default(0)

  status OnboardingStatus @default(NOT_STARTED)

  completedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("onboarding_progress")
}

model HealthJournalSettings {
  id        String @id @default(uuid())
  patientId String @unique

  /**
   * Tracking preferences
   */
  trackSymptoms    Boolean @default(true)
  trackMood        Boolean @default(true)
  trackSleep       Boolean @default(true)
  trackWater       Boolean @default(false)
  trackNutrition   Boolean @default(false)
  trackExercise    Boolean @default(false)
  trackMedications Boolean @default(true)
  trackVitals      Boolean @default(false)

  /**
   * Reminder preferences
   */
  remindersEnabled Boolean @default(true)

  morningReminder   String?
  afternoonReminder String?
  eveningReminder   String?

  /**
   * Journal insights
   */
  weeklySummary  Boolean @default(true)
  monthlySummary Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model Allergy {
  id String @id @default(uuid())

  snomedCode String? @unique

  name String

  description String? @db.Text

  category String?

  severity AllergySeverity?

  common Boolean @default(false)

  searchable Boolean @default(true)

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patientAllergies PatientAllergy[]

  @@index([name])
  @@index([category])
  @@index([common])
  @@index([active])
}

model Person {
  id                      String                   @id @default(uuid())
  firstName               String
  middleName              String?
  lastName                String
  preferredName           String?
  profileImageUrl         String?
  dateOfBirth             DateTime?
  gender                  Gender?
  countryId               String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  deletedAt               DateTime?
  administrator           Administrator?
  appointmentParticipants AppointmentParticipant[]
  patient                 Patient?
  country                 Country?                 @relation(fields: [countryId], references: [id])
  personAddresses         PersonAddress[]
  practitioner            Practitioner?
  user                    User?
}

model Country {
  id String @id @default(uuid())

  iso2 String @unique

  iso3 String @unique

  numericCode String? @unique

  name String

  officialName String?

  nationality String?

  phoneCode String?

  currencyCode String?

  currencyName String?

  continent String?

  region String?

  subregion String?

  flagEmoji    String?
  flagImageUrl String?

  searchable Boolean @default(true)

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses          Address[]
  people             Person[]
  identityDocuments  IdentityDocument[]
  insuranceProviders InsuranceProvider[]

  @@index([name])
  @@index([continent])
  @@index([region])
  @@index([active])
}

model Address {
  id              String          @id @default(uuid())
  line1           String
  line2           String?
  suburb          String?
  city            String
  province        String?
  postalCode      String?
  latitude        Decimal?        @db.Decimal(10, 7)
  longitude       Decimal?        @db.Decimal(10, 7)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  countryId       String?
  country         Country?        @relation(fields: [countryId], references: [id])
  branches        Branch[]
  imagingCenters  ImagingCenter[]
  organizations   Organization[]
  personAddresses PersonAddress[]
  pharmacies      Pharmacy[]
  practices       Practice[]
}

model PersonAddress {
  id        String      @id @default(uuid())
  personId  String
  addressId String
  type      AddressType
  isPrimary Boolean     @default(false)
  validFrom DateTime?
  validTo   DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  address   Address     @relation(fields: [addressId], references: [id], onDelete: Cascade)
  person    Person      @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([personId, addressId, type])
  @@index([personId])
  @@index([addressId])
}

model User {
  id                          String                    @id @default(uuid())
  personId                    String                    @unique
  email                       String                    @unique
  phoneNumber                 String?                   @unique
  username                    String?                   @unique
  passwordHash                String
  userType                    UserType
  status                      UserStatus                @default(PENDING)
  emailVerified               Boolean                   @default(false)
  phoneVerified               Boolean                   @default(false)
  twoFactorEnabled            Boolean                   @default(false)
  lastLoginAt                 DateTime?
  lastPasswordChangeAt        DateTime?
  failedLoginAttempts         Int                       @default(0)
  lockedUntil                 DateTime?
  createdAt                   DateTime                  @default(now())
  updatedAt                   DateTime                  @updatedAt
  deletedAt                   DateTime?
  refreshTokenHash            String?
  createdAISymptomAssessments AISymptomAssessment[]
  accessLogs                  AccessLog[]
  administrator               Administrator?
  auditLogs                   AuditLog[]
  cdsActions                  CDSAction[]
  carePlanNotes               CarePlanNote[]
  assignedCarePlanTasks       CarePlanTask[]
  assignedComplianceIssues    ComplianceIssue[]         @relation("AssignedComplianceIssue")
  reportedComplianceIssues    ComplianceIssue[]         @relation("ReportedComplianceIssue")
  grantedConsents             Consent[]
  conversations               ConversationParticipant[]
  dataAccessConsents          DataAccessConsent[]
  deviceTokens                DeviceToken[]
  sentMessages                Message[]
  notifications               Notification[]
  notificationPreferences     NotificationPreference[]
  organizationMemberships     OrganizationMember[]
  patient                     Patient?
  practitioner                Practitioner?
  referralNotes               ReferralNote[]
  reportedSecurityIncidents   SecurityIncident[]
  telemedicineChats           TelemedicineChat[]
  telemedicineEvents          TelemedicineEvent[]
  telemedicineParticipants    TelemedicineParticipant[]
  person                      Person                    @relation(fields: [personId], references: [id], onDelete: Cascade)
  roles                       UserRole[]
  verificationRequests        VerificationRequest[]
  createdConversations        Conversation[]            @relation("ConversationCreator")
  onboardingProgress          OnboardingProgress?

  @@index([email])
  @@index([phoneNumber])
  @@index([username])
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]
}

model UserRole {
  id         String   @id @default(uuid())
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model Patient {
  id                      String                    @id @default(uuid())
  personId                String                    @unique
  userId                  String                    @unique
  patientNumber           String?                   @unique
  deceased                Boolean                   @default(false)
  dateOfDeath             DateTime?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  aianalyses              AIAnalysis[]
  aiSymptomAssessments    AISymptomAssessment[]
  appointments            Appointment[]
  cdsRuleExecutions       CDSRuleExecution[]
  carePlans               CarePlan[]
  claims                  Claim[]
  clinicalDecisionSupport ClinicalDecisionSupport[]
  consents                Consent[]
  dataAccessConsents      DataAccessConsent[]
  emergencyContacts       EmergencyContact[]
  familyMemberships       FamilyMember[]            @relation("FamilyMember")
  ownedFamilyMembers      FamilyMember[]            @relation("FamilyOwner")
  healthPassport          HealthPassport?
  baseline                PatientBaseline?
  identityDocuments       IdentityDocument[]
  imagingOrders           ImagingOrder[]
  imagingStudies          ImagingStudy[]
  insurancePolicies       InsurancePolicy[]
  invoices                Invoice[]
  labOrders               LabOrder[]
  medicalRecord           MedicalRecord?
  person                  Person                    @relation(fields: [personId], references: [id], onDelete: Cascade)
  user                    User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  patientInsurances       PatientInsurance[]
  prescriptions           Prescription[]
  publicHealthReports     PublicHealthReport[]
  receipts                Receipt[]
  referrals               Referral[]
  telemedicineConsents    TelemedicineConsent[]
  wearableDevices         WearableDevice[]
  healthJournals          HealthJournal[]
  clinicalEpisodes        ClinicalEpisode[]
  riskAssessments         RiskAssessment[]
  healthGoals             HealthGoal[]
  healthJournalSettings   HealthJournalSettings?

  heightCm Decimal? @db.Decimal(5, 2)
  weightKg Decimal? @db.Decimal(5, 2)

  dominantHand       DominantHand?
  smokingStatus      SmokingStatus?
  alcoholConsumption AlcoholConsumption?
  exerciseFrequency  ExerciseFrequency?
  occupation         String?

  @@index([patientNumber])
}

model FamilyMember {
  id                    String   @id @default(uuid())
  ownerPatientId        String
  memberPatientId       String
  relationship          String
  canViewRecords        Boolean  @default(true)
  canManageAppointments Boolean  @default(false)
  canReceiveAlerts      Boolean  @default(true)
  createdAt             DateTime @default(now())
  memberPatient         Patient  @relation("FamilyMember", fields: [memberPatientId], references: [id], onDelete: Cascade)
  ownerPatient          Patient  @relation("FamilyOwner", fields: [ownerPatientId], references: [id], onDelete: Cascade)

  @@unique([ownerPatientId, memberPatientId])
  @@index([ownerPatientId])
  @@index([memberPatientId])
}

model Practitioner {
  id                      String                      @id @default(uuid())
  personId                String                      @unique
  userId                  String                      @unique
  registrationNumber      String                      @unique
  practiceNumber          String?
  practitionerType        PractitionerType
  status                  PractitionerStatus          @default(PENDING)
  biography               String?
  yearsExperience         Int?
  departmentId            String?
  verified                Boolean                     @default(false)
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt
  aianalyses              AIAnalysis[]
  aiClinicalReviews       AIClinicalReview[]
  appointments            Appointment[]
  cdsOverrides            CDSOverride[]
  carePlans               CarePlan[]
  clinicalDecisionSupport ClinicalDecisionSupport[]
  criticalResults         CriticalResult[]
  encounters              Encounter[]
  imagingOrders           ImagingOrder[]
  imagingReports          ImagingReport[]
  imagingStudies          ImagingStudy[]
  insuranceAuthorizations InsuranceAuthorization[]
  labAudits               LabAudit[]
  labCalibrations         LabCalibration[]
  labOrders               LabOrder[]
  practices               Practice[]
  department              Department?                 @relation(fields: [departmentId], references: [id])
  person                  Person                      @relation(fields: [personId], references: [id])
  user                    User                        @relation(fields: [userId], references: [id])
  availability            PractitionerAvailability[]
  organizations           PractitionerOrganization[]
  qualifications          PractitionerQualification[]
  specialties             PractitionerSpecialty[]
  prescriptions           Prescription[]
  publicHealthReports     PublicHealthReport[]
  referralsReceived       Referral[]                  @relation("ReceivingPractitioner")
  referralsSent           Referral[]                  @relation("ReferringPractitioner")
  resultAmendments        ResultAmendment[]
  resultVerifications     ResultVerification[]
  securityIncidents       SecurityIncident[]
  specimenCollections     SpecimenCollection[]
  healthJournals          HealthJournal[]
  clinicalEpisodes        ClinicalEpisode[]
  riskAssessments         RiskAssessment[]
  healthGoals             HealthGoal[]
}

model Administrator {
  id             String   @id @default(uuid())
  personId       String   @unique
  userId         String   @unique
  employeeNumber String?
  department     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  person         Person   @relation(fields: [personId], references: [id])
  user           User     @relation(fields: [userId], references: [id])
}

model EmergencyContact {
  id           String           @id @default(uuid())
  patientId    String
  fullName     String
  relationship RelationshipType
  phoneNumber  String
  email        String?
  isPrimary    Boolean          @default(false)
  createdAt    DateTime         @default(now())
  patient      Patient          @relation(fields: [patientId], references: [id])
}

model IdentityDocument {
  id               String               @id @default(uuid())
  patientId        String
  type             IdentityDocumentType
  documentNumber   String
  issuingCountryId String?
  expiryDate       DateTime?
  verified         Boolean              @default(false)
  createdAt        DateTime             @default(now())
  issuingCountry   Country?             @relation(fields: [issuingCountryId], references: [id])
  patient          Patient              @relation(fields: [patientId], references: [id])
}

model VerificationRequest {
  id            String             @id @default(uuid())
  userId        String
  type          VerificationType
  status        VerificationStatus
  submittedAt   DateTime           @default(now())
  reviewedAt    DateTime?
  reviewerNotes String?
  user          User               @relation(fields: [userId], references: [id])
}

model Specialty {
  id String @id @default(uuid())

  code String? @unique

  name String

  description String? @db.Text

  category String?

  searchable Boolean @default(true)

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  practitioners PractitionerSpecialty[]

  @@index([name])
  @@index([category])
  @@index([active])
}

model PractitionerSpecialty {
  id             String       @id @default(uuid())
  practitionerId String
  specialtyId    String
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id])
  specialty      Specialty    @relation(fields: [specialtyId], references: [id])

  @@unique([practitionerId, specialtyId])
}

model Qualification {
  id            String                      @id @default(uuid())
  name          String
  practitioners PractitionerQualification[]
}

model PractitionerQualification {
  id              String        @id @default(uuid())
  practitionerId  String
  qualificationId String
  institution     String?
  graduationYear  Int?
  practitioner    Practitioner  @relation(fields: [practitionerId], references: [id])
  qualification   Qualification @relation(fields: [qualificationId], references: [id])
}

model Practice {
  id                String             @id @default(uuid())
  practitionerId    String
  name              String
  addressId         String?
  phone             String?
  email             String?
  organizationId    String?
  createdAt         DateTime           @default(now())
  appointments      Appointment[]
  imagingCenters    ImagingCenter[]
  laboratories      Laboratory[]
  address           Address?           @relation(fields: [addressId], references: [id])
  organization      Organization?      @relation(fields: [organizationId], references: [id])
  practitioner      Practitioner       @relation(fields: [practitionerId], references: [id])
  locations         PracticeLocation[]
  referralsReceived Referral[]         @relation("ReceivingPractice")
  referralsSent     Referral[]         @relation("ReferringPractice")
}

model PracticeLocation {
  id         String   @id @default(uuid())
  practiceId String
  latitude   Decimal  @db.Decimal(10, 7)
  longitude  Decimal  @db.Decimal(10, 7)
  radiusKm   Int      @default(20)
  practice   Practice @relation(fields: [practiceId], references: [id])
}

model HealthPassport {
  id                String                @id @default(uuid())
  patientId         String                @unique
  bloodType         BloodType?
  organDonor        Boolean               @default(false)
  emergencyNotes    String?
  shareByDefault    Boolean               @default(false)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  patient           Patient               @relation(fields: [patientId], references: [id], onDelete: Cascade)
  allergies         PatientAllergy[]
  conditions        PatientCondition[]
  immunizations     PatientImmunization[]
  medications       PatientMedication[]
  rhesusFactor      RhesusFactor?
  patientDiagnoses  PatientDiagnosis[]
  patientProcedures PatientProcedure[]
}

model PatientAllergy {
  id String @id @default(uuid())

  healthPassportId String

  allergyId String

  severity AllergySeverity @default(MILD)

  reaction String?

  reactionNotes String? @db.Text

  onsetDate DateTime?

  lastReaction DateTime?

  verified Boolean @default(false)

  verifiedBy String?

  status AllergyStatus @default(ACTIVE)

  notes String? @db.Text

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  healthPassport HealthPassport @relation(fields: [healthPassportId], references: [id], onDelete: Cascade)

  allergy Allergy @relation(fields: [allergyId], references: [id])

  @@unique([healthPassportId, allergyId])
  @@index([healthPassportId])
  @@index([allergyId])
  @@index([severity])
  @@index([status])
}

model Condition {
  id String @id @default(uuid())

  snomedCode String? @unique

  icd10Code String?

  name String

  description String? @db.Text

  category String?

  bodySystem String?

  chronic Boolean @default(false)

  communicable Boolean @default(false)

  reportable Boolean @default(false)

  searchable Boolean @default(true)

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patientConditions PatientCondition[]

  @@index([name])
  @@index([category])
  @@index([bodySystem])
  @@index([chronic])
  @@index([active])
}

model PatientCondition {
  id String @id @default(uuid())

  healthPassportId String

  conditionId String

  diagnosedAt DateTime?

  resolvedAt DateTime?

  status ConditionStatus @default(ACTIVE)

  severity ConditionSeverity?

  stage String?

  chronic Boolean @default(false)

  primaryCondition Boolean @default(false)

  diagnosedBy String?

  treatmentPlan String? @db.Text

  outcome String?

  notes String? @db.Text

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  healthPassport HealthPassport @relation(fields: [healthPassportId], references: [id], onDelete: Cascade)

  condition Condition @relation(fields: [conditionId], references: [id])

  @@unique([healthPassportId, conditionId])
  @@index([healthPassportId])
  @@index([conditionId])
  @@index([status])
  @@index([severity])
}

model Medication {
  id String @id @default(uuid())

  rxNormCode String? @unique

  name String
  genericName String?
  brandName String?

  description String? @db.Text
  category String?

  controlled Boolean @default(false)
  prescriptionRequired Boolean @default(true)

  searchable Boolean @default(true)
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patientMedications PatientMedication[]
  prescriptionItems  PrescriptionItem[]
  medicationEffects  MedicationEffect[]

  strengths MedicationStrength[]

  @@index([name])
  @@index([genericName])
  @@index([brandName])
  @@index([category])
  @@index([active])
  @@index([searchable])
}

model MedicationStrength {
  id String @id @default(uuid())

  medicationId String

  strength String
  dosageForm String?
  route String?

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  medication Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)

  @@unique([medicationId, strength, dosageForm, route])
  @@index([medicationId])
  @@index([active])
}

model PatientMedication {
  id String @id @default(uuid())

  healthPassportId String

  medicationId String

  dosage String?

  frequency String?

  route String?

  indication String?

  instructions String? @db.Text

  prescribedBy String?

  startedAt DateTime?

  endedAt DateTime?

  ongoing Boolean @default(false)

  adherencePercentage Float?

  missedDoses Int?

  sideEffects String? @db.Text

  effectiveness String?

  status MedicationStatus @default(ACTIVE)

  notes String? @db.Text

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  healthPassport HealthPassport @relation(fields: [healthPassportId], references: [id], onDelete: Cascade)

  medication Medication @relation(fields: [medicationId], references: [id])

  @@unique([healthPassportId, medicationId])
  @@index([healthPassportId])
  @@index([medicationId])
  @@index([status])
  @@index([ongoing])
}

model PatientImmunization {
  id String @id @default(uuid())

  healthPassportId String

  immunizationId String

  administeredAt DateTime?

  doseNumber Int?

  batchNumber String?

  manufacturer String?

  administeredBy String?

  facility String?

  route String?

  site String?

  adverseReaction Boolean @default(false)

  adverseReactionNotes String? @db.Text

  nextDueDate DateTime?

  status ImmunizationStatus @default(COMPLETED)

  notes String? @db.Text

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  healthPassport HealthPassport @relation(fields: [healthPassportId], references: [id], onDelete: Cascade)

  immunization Immunization @relation(fields: [immunizationId], references: [id])

  @@unique([healthPassportId, immunizationId, doseNumber])
  @@index([healthPassportId])
  @@index([immunizationId])
  @@index([status])
  @@index([administeredAt])
}

model EncounterType {
  id          String      @id @default(uuid())
  name        String      @unique
  description String?
  encounters  Encounter[]
}

model MedicalRecord {
  id                 String      @id @default(uuid())
  patientId          String      @unique
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  allergies          String?
  bloodType          BloodType?
  chronicConditions  String?
  currentMedications String?
  familyHistory      String?
  immunizationNotes  String?
  organDonor         Boolean     @default(false)
  pastMedicalHistory String?
  socialHistory      String?
  surgicalHistory    String?
  encounters         Encounter[]
  patient            Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model Encounter {
  id                      String                    @id @default(uuid())
  medicalRecordId         String
  practitionerId          String?
  encounterTypeId         String
  startedAt               DateTime
  endedAt                 DateTime?
  chiefComplaint          String?
  assessment              String?
  plan                    String?
  notes                   String?
  createdAt               DateTime                  @default(now())
  aianalyses              AIAnalysis[]
  aiSymptomAssessments    AISymptomAssessment[]
  appointment             Appointment?
  attachments             Attachment[]
  cdsRuleExecutions       CDSRuleExecution[]
  carePlans               CarePlan[]
  clinicalDecisionSupport ClinicalDecisionSupport[]
  clinicalNotes           ClinicalNote[]
  vitals                  ClinicalVital[]
  encounterType           EncounterType             @relation(fields: [encounterTypeId], references: [id])
  medicalRecord           MedicalRecord             @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)
  practitioner            Practitioner?             @relation(fields: [practitionerId], references: [id])
  imagingOrders           ImagingOrder[]
  imagingStudies          ImagingStudy[]
  insuranceAuthorizations InsuranceAuthorization[]
  invoices                Invoice[]
  labOrders               LabOrder[]
  diagnoses               PatientDiagnosis[]
  procedures              PatientProcedure[]
  prescriptions           Prescription[]
  publicHealthReports     PublicHealthReport[]
  referrals               Referral[]
  telemedicineSessions    TelemedicineSession[]
  healthJournals          HealthJournal[]
  clinicalEpisodes        ClinicalEpisode[]
}

model ClinicalNote {
  id                String           @id @default(uuid())
  encounterId       String
  title             String?
  note              String
  clinicalEpisodeId String?
  createdAt         DateTime         @default(now())
  encounter         Encounter        @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  clinicalEpisode   ClinicalEpisode? @relation(fields: [clinicalEpisodeId], references: [id], onDelete: SetNull)
}

model Attachment {
  id               String                      @id @default(uuid())
  encounterId      String
  fileName         String
  mimeType         String
  url              String
  uploadedAt       DateTime                    @default(now())
  encounter        Encounter                   @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  symptomLogs      SymptomLogAttachment[]
  clinicalEpisodes ClinicalEpisodeAttachment[]
}

model VitalType {
  id String @id @default(uuid())

  code String @unique

  name String

  description String? @db.Text

  category String?

  unit String?

  normalMin Float?

  normalMax Float?

  decimalPlaces Int @default(0)

  searchable Boolean @default(true)

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinicalVitals ClinicalVital[]

  @@index([name])
  @@index([category])
  @@index([active])
}

model ClinicalVital {
  id                String           @id @default(uuid())
  encounterId       String
  vitalTypeId       String
  clinicalEpisodeId String?
  value             Decimal          @db.Decimal(10, 2)
  measuredAt        DateTime
  encounter         Encounter        @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  vitalType         VitalType        @relation(fields: [vitalTypeId], references: [id])
  clinicalEpisode   ClinicalEpisode? @relation(fields: [clinicalEpisodeId], references: [id], onDelete: SetNull)
}

model Diagnosis {
  id String @id @default(uuid())

  icd10Code String? @unique

